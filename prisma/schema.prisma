// Catálogo e Solicitação de Presentes — schema V1.
//
// Duas regras atravessam o arquivo inteiro:
//
// 1. Nada é deletado. Produto, categoria e usuário são desativados via `ativo`,
//    porque solicitações antigas precisam continuar legíveis exatamente como
//    foram criadas.
// 2. Os campos das integrações de fase 2 (`sku_tiny`, `tiny_*`, `rastreio`,
//    `salesforce_id`) já existem aqui, nulos no V1. Ligar Tiny e Salesforce
//    depois não deve exigir migração de dados nem mudança de tela.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Perfil {
  consultor
  admin
  financeiro
}

enum TipoValor {
  exato
  medio
}

enum OrigemCliente {
  manual
  importacao
  salesforce
}

enum MotivoEnvio {
  aniversario
  casamento
  nascimento
  reforco_relacionamento
  primeiro_milhao
  outro
}

/// Os nove status do fluxo da spec, mais `cancelado`.
///
/// `cancelado` não está na lista dos nove, mas é exigido por duas regras do
/// documento: "de Deu problema a solicitação pode voltar para qualquer status
/// anterior ou ser cancelada" e "o saldo considera todos os status exceto os
/// cancelados e devolvidos". Sem ele não há como representar nenhuma das duas.
enum StatusSolicitacao {
  pendente
  aguardando_aprovacao
  aguardando_compra
  comprado
  organizando_envio
  entregue
  cliente_confirmou
  deu_problema
  devolvido
  cancelado
}

// ---------------------------------------------------------------------------
// Usuários
// ---------------------------------------------------------------------------

/// Espelho local da identidade do SSO. Perfil e limite mensal moram aqui, e não
/// no provedor de identidade, para que Relacionamento ajuste sem passar por TI.
model Usuario {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  /// `sub` do token OIDC. Guardado para reconhecer o usuário mesmo que o
  /// e-mail mude no provedor de identidade.
  ssoSubject   String?  @unique @map("sso_subject")
  perfil       Perfil   @default(consultor)
  /// Teto de gasto mensal em BRL. Nulo = sem limite definido.
  /// No V1 estourar o limite apenas sinaliza; bloqueio depende de decisão da área.
  limiteMensal Decimal? @map("limite_mensal") @db.Decimal(12, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  solicitacoes    Solicitacao[]          @relation("SolicitacoesDoConsultor")
  historicos      SolicitacaoHistorico[]
  clientesCriados Cliente[]              @relation("ClientesCriadosPor")

  @@index([perfil, ativo])
  @@map("usuarios")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Categoria {
  id       String   @id @default(cuid())
  nome     String   @unique
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  produtos Produto[]

  @@index([ativo])
  @@map("categorias")
}

model Produto {
  id              String    @id @default(cuid())
  nome            String
  descricao       String?
  categoriaId     String    @map("categoria_id")
  fotoUrl         String?   @map("foto_url")
  valor           Decimal   @db.Decimal(12, 2)
  /// `exato` = preço fechado. `medio` = estimativa, exibida como "a partir de".
  tipoValor       TipoValor @default(exato) @map("tipo_valor")
  /// Produtos externos e específicos não têm estoque. Quando falso, a tela
  /// omite disponibilidade em vez de mostrar zero.
  controlaEstoque Boolean   @default(false) @map("controla_estoque")
  estoque         Int?
  ativo           Boolean   @default(true)
  /// Fase 2: SKU correspondente no Tiny ERP.
  skuTiny         String?   @map("sku_tiny")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  atualizadoEm    DateTime  @updatedAt @map("atualizado_em")

  categoria Categoria         @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  itens     SolicitacaoItem[]

  @@index([ativo, categoriaId])
  @@index([nome])
  @@map("produtos")
}

// ---------------------------------------------------------------------------
// Clientes
// ---------------------------------------------------------------------------

/// CPF é a chave de deduplicação: armazenado apenas com dígitos, sem máscara,
/// para que a busca não dependa de formatação.
model Cliente {
  id           String        @id @default(cuid())
  nome         String
  cpf          String        @unique
  telefone     String?
  email        String?
  /// Fase 2: id do registro correspondente no Salesforce.
  salesforceId String?       @unique @map("salesforce_id")
  origem       OrigemCliente @default(manual)
  criadoPor    String?       @map("criado_por")
  criadoEm     DateTime      @default(now()) @map("criado_em")
  atualizadoEm DateTime      @updatedAt @map("atualizado_em")

  criador      Usuario?      @relation("ClientesCriadosPor", fields: [criadoPor], references: [id], onDelete: SetNull)
  solicitacoes Solicitacao[]

  @@index([nome])
  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Solicitações
// ---------------------------------------------------------------------------

model Solicitacao {
  id          String @id @default(cuid())
  /// Código sequencial legível por ano: SOL-2026-0001. Ver src/lib/codigo.ts.
  codigo      String @unique
  consultorId String @map("consultor_id")
  clienteId   String @map("cliente_id")

  motivo        MotivoEnvio
  /// Obrigatório quando `motivo = outro`; validado na camada de aplicação.
  motivoOutro   String?     @map("motivo_outro")
  mensagemCarta String      @map("mensagem_carta")
  observacoes   String?

  status     StatusSolicitacao @default(pendente)
  /// Soma congelada dos itens. Recalculada em toda escrita de item, dentro da
  /// mesma transação, para que relatório e saldo não dependam de join.
  valorTotal Decimal           @default(0) @map("valor_total") @db.Decimal(12, 2)

  // Endereço gravado como snapshot: se o cliente se mudar, a solicitação antiga
  // continua mostrando para onde o presente foi de fato enviado.
  entregaCep          String  @map("entrega_cep")
  entregaLogradouro   String  @map("entrega_logradouro")
  entregaNumero       String  @map("entrega_numero")
  entregaComplemento  String? @map("entrega_complemento")
  entregaBairro       String  @map("entrega_bairro")
  entregaCidade       String  @map("entrega_cidade")
  entregaUf           String  @map("entrega_uf") @db.Char(2)
  entregaDestinatario String  @map("entrega_destinatario")

  // Fase 2 — nulos no V1.
  tinyPedidoId   String? @map("tiny_pedido_id")
  tinyStatus     String? @map("tiny_status")
  rastreio       String?
  transportadora String?

  dataSolicitacao DateTime @default(now()) @map("data_solicitacao")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  consultor Usuario                @relation("SolicitacoesDoConsultor", fields: [consultorId], references: [id], onDelete: Restrict)
  cliente   Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  itens     SolicitacaoItem[]
  historico SolicitacaoHistorico[]

  @@index([consultorId, dataSolicitacao])
  @@index([status])
  @@index([clienteId])
  @@index([dataSolicitacao])
  @@map("solicitacoes")
}

/// Ou o item vem do catálogo (`produtoId`), ou é um presente específico
/// (`descricaoLivre` + `urlExterna`). A exclusividade é garantida por CHECK
/// constraint na migration e revalidada na camada de aplicação.
///
/// `valorUnitario` é sempre congelado no momento da criação: item de catálogo
/// copia o valor do produto, item específico usa o valor digitado. Alterar o
/// preço do produto depois não mexe em solicitação já feita.
model SolicitacaoItem {
  id             String   @id @default(cuid())
  solicitacaoId  String   @map("solicitacao_id")
  produtoId      String?  @map("produto_id")
  descricaoLivre String?  @map("descricao_livre")
  urlExterna     String?  @map("url_externa")
  valorUnitario  Decimal  @map("valor_unitario") @db.Decimal(12, 2)
  quantidade     Int      @default(1)
  criadoEm       DateTime @default(now()) @map("criado_em")

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  produto     Produto?    @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([solicitacaoId])
  @@index([produtoId])
  @@map("solicitacao_itens")
}

/// Uma linha por mudança de status. É o que sustenta a auditoria e responde
/// "por que essa solicitação parou". Nunca é editado nem apagado.
model SolicitacaoHistorico {
  id             String             @id @default(cuid())
  solicitacaoId  String             @map("solicitacao_id")
  statusAnterior StatusSolicitacao? @map("status_anterior")
  statusNovo     StatusSolicitacao  @map("status_novo")
  usuarioId      String?            @map("usuario_id")
  /// Obrigatório em `deu_problema` e `devolvido`.
  motivo         String?
  criadoEm       DateTime           @default(now()) @map("criado_em")

  solicitacao Solicitacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([solicitacaoId, criadoEm])
  @@map("solicitacao_historico")
}

/// Contador do código sequencial por ano. Uma linha por ano, incrementada
/// dentro da transação que cria a solicitação.
model ContadorCodigo {
  ano   Int @id
  valor Int @default(0)

  @@map("contador_codigo")
}

// ---------------------------------------------------------------------------
// Arquivos
// ---------------------------------------------------------------------------

/// Foto de produto guardada no próprio banco.
///
/// A spec previa um bucket S3-compatível, e o `env` já reserva as variáveis.
/// No V1 o arquivo fica aqui por uma razão prática: são algumas dezenas de
/// fotos de catálogo, e depender de bucket provisionado atrasaria a única
/// coisa que a área precisa fazer sozinha — cadastrar produto com foto.
///
/// A troca por bucket mexe em um lugar só: `src/lib/arquivos.ts`. `fotoUrl`
/// continua sendo uma URL, e as telas não sabem de onde ela vem.
model Arquivo {
  id        String   @id @default(cuid())
  nome      String
  /// MIME type. Validado na aplicação contra a lista de imagens aceitas.
  tipo      String
  /// Em bytes. Redundante com `length(dados)`, mas evita ler o binário só
  /// para listar tamanho.
  tamanho   Int
  dados     Bytes
  criadoPor String?  @map("criado_por")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("arquivos")
}
