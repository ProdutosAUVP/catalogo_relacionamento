# ---------------------------------------------------------------------------
# Banco de dados (Postgres)
# Local: docker compose up -d  →  a string abaixo já aponta para o container.
# Railway: o valor vem da variável do serviço Postgres do projeto.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://catalogo:catalogo@localhost:5432/catalogo_presentes?schema=public"

# ---------------------------------------------------------------------------
# NextAuth / SSO AUVP (OIDC)
# AUTH_SECRET: gere com `npx auth secret` ou `openssl rand -base64 32`.
# AUTH_OIDC_ISSUER: URL do issuer OIDC (o /.well-known/openid-configuration
#   é resolvido a partir dela).
# Pendência: definir o provedor (Google Workspace | Entra ID | Keycloak | outro)
#   e quem libera as credenciais do client. Ver docs/07-perguntas-em-aberto.md.
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_OIDC_ISSUER=""
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""
# Nome exibido no botão de login.
AUTH_OIDC_NAME="AUVP SSO"
# Claim opcional que carrega grupos/departamento no token do provedor.
# Se o SSO devolver grupos, preencher para mapear perfil automaticamente.
AUTH_OIDC_GROUPS_CLAIM=""

# E-mails que recebem perfil admin no primeiro login (separados por vírgula).
# Necessário para destravar o bootstrap: sem isso o primeiro usuário entra como
# consultor e ninguém consegue promover ninguém.
BOOTSTRAP_ADMIN_EMAILS=""

# Em desenvolvimento, permite entrar sem SSO configurado com um usuário fake.
# NUNCA habilitar em produção — o código recusa a flag fora de NODE_ENV=development.
AUTH_DEV_BYPASS="false"

# ---------------------------------------------------------------------------
# Storage das fotos de produto (bucket S3-compatível)
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="catalogo-presentes"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
# Host público das imagens, usado no next.config.ts (sem protocolo).
NEXT_PUBLIC_STORAGE_HOSTNAME=""

# ---------------------------------------------------------------------------
# Provedores de dados (camada trocável — ver src/lib/providers)
# local     → catálogo e clientes no próprio Postgres (V1)
# tiny      → catálogo vindo do Tiny ERP (fase 2)
# salesforce→ clientes vindos do Salesforce (fase 2)
# ---------------------------------------------------------------------------
CATALOG_PROVIDER="local"
CLIENT_PROVIDER="local"

# ---------------------------------------------------------------------------
# Fase 2 — credenciais reservadas, vazias no V1
# ---------------------------------------------------------------------------
TINY_API_TOKEN=""
TINY_API_BASE_URL="https://api.tiny.com.br/api2"
SALESFORCE_INSTANCE_URL=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Integrações auxiliares
# ---------------------------------------------------------------------------
VIACEP_BASE_URL="https://viacep.com.br/ws"
